{
  "name": "arcade-duel-desktop",
  "version": "1.2.0",
  "description": "Windows desktop client for ARCADE DUEL",
  "author": "Twyair67",
  "license": "MIT",
  "main": "main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node ..\\scripts\\sync-web.js desktop && electron .",
    "dist:win": "node ..\\scripts\\sync-web.js desktop && electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.twyair67.arcadeduel",
    "productName": "ARCADE DUEL",
    "asar": true,
    "directories": {
      "output": "dist/release"
    },
    "files": [
      "main.js",
      "preload.js",
      "loading.html",
      "loading.css",
      "loading.js",
      "LICENSE",
      "README.md",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "game",
        "to": "game"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
